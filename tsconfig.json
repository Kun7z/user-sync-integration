{
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./dist",
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,

    "esModuleInterop": true,
    "skipLibCheck": true,

    "types": ["jest", "node"],
    "isolatedModules": true
  },

  "include": ["src", "tests", "**/*.spec.ts", "**/*.test.ts", "**/*.mock.ts"]
}
